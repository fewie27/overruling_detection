# Copy this file to .env and fill in the provider you will pass to --api_connector.
# One LLM key is enough. Leave the others empty.
# .env is not committed.

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides. Defaults are fine for a first run.
# OPENAI_HTTP_TIMEOUT_SECONDS=900
# OPENAI_TEMPERATURE=
# ANTHROPIC_MAX_TOKENS=
# ANTHROPIC_TEMPERATURE=
# ANTHROPIC_BASE_URL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MAX_TOKENS=16384
# DEEPSEEK_TEMPERATURE=
# DEEPSEEK_HTTP_TIMEOUT_SECONDS=900

# Local Ollama server (only for --api_connector ollama).
# Default URL is http://127.0.0.1:11434. Default model is llama3.2 (config/models.yaml).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_PREDICT=8192
# OLLAMA_TIMEOUT=900
# OLLAMA_TEMPERATURE=
# OLLAMA_FORMAT_JSON=0

# --- Opinion text ---
# Retrieval order: local cache, then CourtListener if this token is set,
# then the Caselaw Access Project static files (https://static.case.law/).
# Strongly recommended. Without it, opinions missing from the static files cannot be
# retrieved (U.S. Reports after volume 572, F.4th), so not every benchmark entry runs.
# Docs: https://www.courtlistener.com/help/api/rest/
# Token: https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=

# Cached opinion JSON. Created on first successful download.
CASE_OPINION_CACHE_DIR=output/case_opinion_cache

# Print which provider supplied each opinion.
# DEBUG_RETRIEVAL=1
